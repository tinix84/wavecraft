{
  "name": "wavecraft-phase1-portability-proof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone waveform editor preview and separate Phase 1 portability diagnostics.",
  "engines": { "node": ">=24.11.1" },
  "scripts": {
    "start": "node scripts/preview.mjs",
    "preview": "node scripts/preview.mjs",
    "build": "node scripts/build.mjs",
    "build:proof": "node scripts/build.mjs --proof",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node scripts/browser-proof.mjs",
    "package": "node scripts/build.mjs --release",
    "package:proof": "node scripts/build.mjs --proof --release",
    "release": "npm run package"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
